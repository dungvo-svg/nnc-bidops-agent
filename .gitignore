# Source evidence and working data are local/private; never stage by default.
/sources/*
!/sources/README.md
/data-work/*
!/data-work/README.md
!/data-work/fixtures/
/data-work/fixtures/*
!/data-work/fixtures/README.md
/outputs/*
!/outputs/README.md
/.local/
/.env
/.env.*
*.key
*.pem
*.pfx
*.p12
node_modules/
.venv/
__pycache__/
*.pyc

# Copied private research snapshots are source material too.
/discovery/research-snapshots/

# Private publication: scoped synthetic source only; all runtime/business data stays local.
/.claude/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.csv
*.xlsx
*.xls
!/data-work/pilots/
/data-work/pilots/*
